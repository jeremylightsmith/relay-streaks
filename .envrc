# --- Project commands on PATH ---
# Makes bin/ available as bare commands inside this directory: `dev precommit`, `prod logs`.
# `dev --help` / `prod --help` list them all.
PATH_add bin

# Auto-trust the mise configs in the runner's worktrees so a fresh checkout can run the
# pinned toolchain without a `mise trust` prompt.
export MISE_TRUSTED_CONFIG_PATHS="$PWD/.claude/worktrees"

# --- Secrets + per-developer overrides ---
source_env_if_exists ./.envrc.local
